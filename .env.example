# Required: your n8n's API key (Settings → n8n API).
FLOCK_N8N_API_KEY=
# Where Flock calls n8n. In Docker next to n8n: http://n8n:5678
FLOCK_N8N_URL=https://n8n.example.com
# Where people open the n8n editor, if different from FLOCK_N8N_URL.
FLOCK_N8N_UI_URL=https://n8n.example.com

# Optional: Shepherd, the drafting chat. Any OpenAI-compatible endpoint.
FLOCK_SHEPHERD_API_KEY=
# FLOCK_SHEPHERD_BASE_URL=https://openrouter.ai/api/v1
# FLOCK_SHEPHERD_MODEL=anthropic/claude-sonnet-4.5

# Optional: names shown in the UI and alerts.
# FLOCK_ORG_NAME=Example Co
# FLOCK_ADMIN_NAME=Maya
# FLOCK_PUBLIC_URL=https://flock.example.com
# Your own domains: calls to them count as company systems.
# FLOCK_INTERNAL_HOSTS=example.com

# Optional: the background watcher (default every 10 minutes; 0 = off) and Slack.
# FLOCK_WATCH_MINUTES=10
# FLOCK_SLACK_TOKEN=
# FLOCK_SLACK_CHANNEL=C0123456789

# For Cloudflare Access sign-in, use a config file instead (docs/configuration.md).
